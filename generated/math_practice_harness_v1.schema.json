{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "math-practice-harness-v1",
  "title": "Math Practice Harness v1",
  "type": "object",
  "required": ["harnessVersion", "generatedAt", "curriculum", "unit", "taxonomy", "stages", "problems"],
  "properties": {
    "harnessVersion": {
      "const": "math-practice-v1"
    },
    "generatedAt": {
      "type": "string"
    },
    "curriculum": {
      "type": "object",
      "required": ["country", "name", "course", "gradeBand"],
      "properties": {
        "country": { "type": "string" },
        "name": { "type": "string" },
        "course": { "type": "string" },
        "gradeBand": { "type": "string" }
      },
      "additionalProperties": true
    },
    "unit": {
      "type": "object",
      "required": ["sequence", "title", "slug", "subtopics"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "subtopics": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "taxonomy": {
      "type": "object",
      "required": ["categoryPath", "categoryLevel1", "categoryLevel2"],
      "properties": {
        "categoryPath": { "type": "string" },
        "categoryLevel1": { "type": "integer" },
        "categoryLevel2": { "type": "integer" },
        "defaultCategoryLevel3": { "type": "integer" }
      },
      "additionalProperties": true
    },
    "outputs": {
      "type": "object",
      "properties": {
        "markdown": { "type": "string" },
        "html": { "type": "string" }
      },
      "additionalProperties": false
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "order", "title", "goal", "concepts"],
        "properties": {
          "id": { "type": "string" },
          "order": { "type": "integer", "minimum": 1 },
          "title": { "type": "string" },
          "goal": { "type": "string" },
          "concepts": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": true
      }
    },
    "problems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "order",
          "stageId",
          "title",
          "content",
          "answer",
          "solution",
          "difficulty",
          "category",
          "concepts",
          "tags",
          "isBonus",
          "relationships",
          "validation"
        ],
        "properties": {
          "id": { "type": "string" },
          "order": { "type": "integer", "minimum": 1 },
          "stageId": { "type": "string" },
          "title": { "type": "string" },
          "content": { "type": "string" },
          "answer": { "type": "string" },
          "solution": { "type": "string" },
          "difficulty": {
            "type": "object",
            "required": ["score", "band"],
            "properties": {
              "score": { "type": "integer", "minimum": 1, "maximum": 10 },
              "band": {
                "enum": ["Basic", "Core", "Application", "Challenge", "Olympiad"]
              }
            },
            "additionalProperties": false
          },
          "category": {
            "type": "object",
            "required": ["level1", "level2", "level3", "path"],
            "properties": {
              "level1": { "type": "integer" },
              "level2": { "type": "integer" },
              "level3": { "type": "integer" },
              "path": { "type": "string" }
            },
            "additionalProperties": false
          },
          "concepts": {
            "type": "array",
            "items": { "type": "string" }
          },
          "tags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "isBonus": { "type": "boolean" },
          "relationships": {
            "type": "object",
            "required": ["prerequisiteProblemIds", "nextProblemId"],
            "properties": {
              "prerequisiteProblemIds": {
                "type": "array",
                "items": { "type": "string" }
              },
              "nextProblemId": {
                "type": ["string", "null"]
              }
            },
            "additionalProperties": true
          },
          "validation": {
            "type": "object",
            "required": ["answerCheckType", "expectedAnswer"],
            "properties": {
              "answerCheckType": {
                "enum": ["manual", "symbolic", "numeric", "multipleChoice"]
              },
              "expectedAnswer": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
