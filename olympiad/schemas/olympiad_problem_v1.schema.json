{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://olympiadai.local/schemas/olympiad_problem_v1.schema.json",
  "title": "OlympiadProblem",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "problem_information",
    "problem",
    "solutions",
    "understanding",
    "problem_dna",
    "thinking",
    "generation",
    "metadata"
  ],
  "properties": {
    "problem_information": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "problem_id",
        "contest",
        "year",
        "round",
        "problem_number",
        "category",
        "difficulty",
        "source"
      ],
      "properties": {
        "problem_id": { "type": "string", "minLength": 1 },
        "contest": { "type": "string", "minLength": 1 },
        "year": { "type": "integer" },
        "round": { "type": ["string", "null"] },
        "problem_number": { "type": "string", "minLength": 1 },
        "category": { "type": ["string", "null"] },
        "difficulty": { "type": ["integer", "null"], "minimum": 1, "maximum": 10 },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["problem_statement"],
      "properties": {
        "problem_statement": { "type": "string", "minLength": 1 }
      }
    },
    "solutions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["official_solutions", "solution_summary"],
      "properties": {
        "official_solutions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["solution_id", "label", "text", "source_reference"],
            "properties": {
              "solution_id": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "text": { "type": "string", "minLength": 1 },
              "source_reference": { "type": "string", "minLength": 1 }
            }
          }
        },
        "solution_summary": { "type": ["string", "null"] }
      }
    },
    "understanding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concepts", "subconcepts", "prerequisites"],
      "properties": {
        "concepts": { "type": "array", "items": { "type": "string" } },
        "subconcepts": { "type": "array", "items": { "type": "string" } },
        "prerequisites": { "type": "array", "items": { "type": "string" } }
      }
    },
    "problem_dna": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "problem_dna",
        "problem_family",
        "problem_template",
        "construction_type"
      ],
      "properties": {
        "problem_dna": { "type": ["object", "null"] },
        "problem_family": { "type": ["string", "null"] },
        "problem_template": { "type": ["string", "null"] },
        "construction_type": { "type": ["string", "null"] }
      }
    },
    "thinking": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "thinking_graph",
        "reasoning_pattern",
        "key_observations",
        "critical_lemmas",
        "construction_steps",
        "failed_attempts"
      ],
      "properties": {
        "thinking_graph": {
          "oneOf": [
            { "$ref": "thinking_graph_v1.schema.json" },
            { "type": "null" }
          ]
        },
        "reasoning_pattern": { "type": ["string", "null"] },
        "key_observations": { "type": "array", "items": { "type": "string" } },
        "critical_lemmas": { "type": "array", "items": { "type": "string" } },
        "construction_steps": { "type": "array", "items": { "type": "string" } },
        "failed_attempts": { "type": "array", "items": { "type": "string" } }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variation_rules", "generalization", "generator_notes"],
      "properties": {
        "variation_rules": { "type": "array", "items": { "type": "string" } },
        "generalization": { "type": ["string", "null"] },
        "generator_notes": { "type": ["string", "null"] }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "created_at",
        "updated_at",
        "validation_status",
        "parser_version",
        "analyzer_version"
      ],
      "properties": {
        "schema_version": { "type": "string", "const": "1.0.0" },
        "created_at": { "type": "string", "minLength": 1 },
        "updated_at": { "type": "string", "minLength": 1 },
        "validation_status": { "type": "string", "minLength": 1 },
        "parser_version": { "type": ["string", "null"] },
        "analyzer_version": { "type": ["string", "null"] }
      }
    }
  }
}
